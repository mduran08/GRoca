\par \page }{\v R0233!dnote!}{\cs16\fs16\up6 #{\footnote \pard\plain \s17\li284\widctlpar\adjustright \f1\fs20\lang1036\cgrid {\cs16\fs16\up6 #}{ R0233}}${\footnote \pard\plain \s17\li284\widctlpar\adjustright \f1\fs20\lang1036\cgrid {\cs16\fs16\up6 $}{
