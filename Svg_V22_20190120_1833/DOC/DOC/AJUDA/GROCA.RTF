\par \page }{\v R0226!dnote!}{\cs16\fs16\up6 #{\footnote \pard\plain \s17\li284\widctlpar\adjustright \f1\fs20\lang1036\cgrid {\cs16\fs16\up6 #}{ R0226}}${\footnote \pard\plain \s17\li284\widctlpar\adjustright \f1\fs20\lang1036\cgrid {\cs16\fs16\up6 $}{
 Afegir una impressora}}K{\footnote \pard\plain \s17\li284\widctlpar\adjustright \f1\fs20\lang1036\cgrid {\cs16\fs16\up6 K}{ configuraci\'f3:impressora;configuraci\'f3;impressora;afegir}}}{\v !fnote!}{ 
\par }\pard\plain \s2\widctlpar\outlinelevel1\adjustright \b\f1\fs20\lang1036\cgrid {Afegir una impressora
\par }\pard\plain \widctlpar\adjustright \f1\fs20\lang1036\cgrid {
\par Aquest bot\'f3 ens presentar\'e0 una nova fitxa a blanc per configurar la nova impressora a la qual volem enviar els llistats. Aquesta configuraci\'f3 nom\'e9s ser\'e0 v\'e0lida per l'ordinador local.
\par 
\par \page }{\v R0230!dnote!}{\cs16\fs16\up6 #{\footnote \pard\plain \s17\li284\widctlpar\adjustright \f1\fs20\lang1036\cgrid {\cs16\fs16\up6 #}{ R0230}}${\footnote \pard\plain \s17\li284\widctlpar\adjustright \f1\fs20\lang1036\cgrid {\cs16\fs16\up6 $}{
