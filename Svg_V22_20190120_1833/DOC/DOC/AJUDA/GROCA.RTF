\par 
\par \page }{\v R0237!dnote!}{\cs16\fs16\up6 #{\footnote \pard\plain \s17\li284\widctlpar\adjustright \f1\fs20\lang1036\cgrid {\cs16\fs16\up6 #}{ R0237}}${\footnote \pard\plain \s17\li284\widctlpar\adjustright \f1\fs20\lang1036\cgrid {\cs16\fs16\up6 $}{
 Afegir un tipus de paper}}K{\footnote \pard\plain \s17\li284\widctlpar\adjustright \f1\fs20\lang1036\cgrid {\cs16\fs16\up6 K}{ configuraci\'f3:tipus de paper;configuraci\'f3;paper;afegir}}}{\v !fnote!}{ 
